# ============================================================
# AppCole GT — Variables de Entorno
# ============================================================
# IMPORTANTE: Copia este archivo como .env y agrega tus claves reales.
# NUNCA subas el archivo .env al repositorio (ya está en .gitignore)
# ============================================================

# URL del proyecto Supabase (pública, segura de exponer)
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Clave anónima/pública de Supabase (pública, para el frontend)
# Obtenla en: Settings > API > Project API keys > anon (public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# NOTA DE SEGURIDAD:
# En producción (Vercel), configure solo VITE_SUPABASE_ANON_KEY
# NUNCA uses la SERVICE_ROLE_KEY en el frontend de producción
